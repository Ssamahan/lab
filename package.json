{
  "name": "ruli-lab-roster",
  "version": "4.0.0",
  "description": "Ruli District Hospital Laboratory Smart Roster - APK via Capacitor",
  "main": "index.html",
  "scripts": {
    "build": "echo 'Single-file app, no build needed'",
    "cap:init": "npx cap init RuliLab rw.gov.ruli.lab --web-dir=.",
    "cap:add:android": "npx cap add android",
    "cap:copy": "npx cap copy",
    "cap:open:android": "npx cap open android",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "apk:release": "cd android && ./gradlew assembleRelease"
  },
  "keywords": ["ruli", "lab", "roster", "hospital", "rwanda"],
  "author": "Kelvin SAMAHANI <smhnklvn@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "^5.7.0",
    "@capacitor/core": "^5.7.0",
    "@capacitor/android": "^5.7.0"
  },
  "dependencies": {}
}
